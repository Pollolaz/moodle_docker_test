# Copy this file to .env and adjust values before running scripts/install.sh

# --- Moodle version ---
# "latest" auto-detects the newest MOODLE_x_STABLE branch from git.moodle.org.
# Or set a short version like "405"/"500", a full branch name (e.g. MOODLE_405_STABLE), or "main".
MOODLE_VERSION=latest

# --- Networking ---
HTTP_PORT=8080

# --- Site ---
# Quote any value that contains spaces — this file is sourced by install.sh.
SITE_FULLNAME="My Moodle Test Site"
SITE_SHORTNAME=MoodleTest

# --- Database (MariaDB) ---
DB_ROOT_PASSWORD=changeme_root
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=changeme_moodle

# --- Admin account created by admin/cli/install.php ---
ADMIN_USER=admin
# Must satisfy Moodle's password policy (upper+lower+digit+symbol, 8+ chars)
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@example.com
